{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug ROS2 C++ Node",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/../../install/approach_path_planning/lib/approach_path_planning/approach_planner",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "AMENT_PREFIX_PATH",
          "value": "${env:AMENT_PREFIX_PATH}"
        },
        {
          "name": "LD_LIBRARY_PATH",
          "value": "${env:LD_LIBRARY_PATH}"
        },
        {
          "name": "RMW_IMPLEMENTATION",
          "value": "${env:RMW_IMPLEMENTATION}"
        },
        {
          "name": "CYCLONEDDS_URI",
          "value": "${env:CYCLONEDDS_URI}"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Break on segfault",
          "text": "handle SIGSEGV stop print pass",
          "ignoreFailures": true
        }
      ],
      "miDebuggerPath": "/usr/bin/gdb",
      "logging": {
        "engineLogging": false
      }
    }
  ]
}